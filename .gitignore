venv/
.venv/
.home/
.local/
.tools/
.silicon-interface/

__pycache__/
*.pyc
*.pyo
*.pyd

# Interface runtime state (contains local trust, rooms, media, watermarks)
core/interface_state/

# Glass-generated team context and advertising memories (runtime artifacts)
prompts/TEAM.md
prompts/TEAM_OF_SILICONS.md
prompts/advertising/

# Worker outputs (generated at runtime)
worker/outputs/*.txt
worker/outputs/_active_workers.json
worker/outputs/_archive_meta.json
worker/outputs/_browser_queue.json
worker/outputs/_worker_registry.json
core/cron/checkbacks.json
core/cron/*.json.lock
worker/outputs/*.json.lock
core/cron/history.json

# Session files (generated at runtime)
sessions/

# Runtime state
.silicon/
.glass.json
.env
.restart_pending
.silicon.pid
.silicon.pid.meta.json
.silicon.stop
.silicon.log
.silicon.err.log
.glass_agent.pid
.glass_agent.pid.meta.json
.glass_agent.log
.glass_agent.err.log
.glass-push.pid
.glass-push.pid.meta.json
.glass-push.log
*.tar.gz
.DS_Store
.silicon-upstream/

# Daily activity logs (generated at runtime; backed up via .backupsilicon)
logs/

# The diagnosis store: every iwantto invocation, for debugging the system
diagnosis/

# Restart requested by `iwantto restart-silicon`; consumed by the event loop
.restart_requested

# Local agent/editor settings
.claude/
