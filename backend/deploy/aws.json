{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Read-only Silicon realtime relay on an existing native host, with an isolated service and private artifact/credential access",
  "Parameters": {
    "InstanceId": {
      "Type": "String",
      "Default": "i-0e418ff3ecd260e3d"
    },
    "InstanceRole": {
      "Type": "String",
      "Default": "space-station-production-ApiRole-5QvnHgxldIB9"
    },
    "HostSecurityGroup": {
      "Type": "String",
      "Default": "sg-015c806c6af2d7f9a"
    },
    "AlbSecurityGroup": {
      "Type": "String",
      "Default": "sg-029ff47081cdd0475"
    },
    "VpcId": {
      "Type": "String",
      "Default": "vpc-04b23a487cfe0bd8e"
    },
    "HttpsListener": {
      "Type": "String",
      "Default": "arn:aws:elasticloadbalancing:us-east-1:234951665042:listener/app/glass--LoadB-PfqLW3131dbk/27b2a2d43fae4e4d/797df6c19eb760d9"
    },
    "CertificateArn": {
      "Type": "String",
      "Default": "arn:aws:acm:us-east-1:234951665042:certificate/c946221a-6c47-4aea-bc37-8a8fb7553ac0"
    },
    "ArtifactBucket": {
      "Type": "String",
      "Default": "silicon-realtime-production-234951665042-us-east-1"
    },
    "RuntimeSecretArn": {
      "Type": "String",
      "Default": "arn:aws:secretsmanager:us-east-1:234951665042:secret:silicon-realtime/production/runtime-NEQfGW"
    }
  },
  "Resources": {
    "HostAccess": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "HostSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 1830,
        "ToPort": 1830,
        "SourceSecurityGroupId": {
          "Ref": "AlbSecurityGroup"
        },
        "Description": "Silicon read-only realtime relay from HTTPS gateway"
      }
    },
    "AlbEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "AlbSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 1830,
        "ToPort": 1830,
        "DestinationSecurityGroupId": {
          "Ref": "HostSecurityGroup"
        },
        "Description": "Silicon read-only realtime relay"
      }
    },
    "RelayAccess": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "silicon-realtime-artifact-and-secret",
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/releases/*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "RuntimeSecretArn"
              }
            }
          ]
        }
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "silicon-realtime",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 1830,
        "TargetType": "instance",
        "Targets": [
          {
            "Id": {
              "Ref": "InstanceId"
            },
            "Port": 1830
          }
        ],
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3
      }
    },
    "HttpsRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Priority": 45,
        "Conditions": [
          {
            "Field": "host-header",
            "Values": [
              "realtime.teamofsilicons.com"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "CertificateAttachment": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerCertificate",
      "Properties": {
        "ListenerArn": {
          "Ref": "HttpsListener"
        },
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "InstanceId"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "ArtifactBucket"
      }
    },
    "RuntimeSecretArn": {
      "Value": {
        "Ref": "RuntimeSecretArn"
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "TargetGroup"
      }
    }
  }
}
